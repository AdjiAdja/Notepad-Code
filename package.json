{
  "name": "malude-notepad-ideas",
  "version": "1.0.0",
  "private": true,
  "description": "Malude Notepad Ideas: notepad developer untuk personal dan korporat (vault terenkripsi, workspace tim, penjelajah berkas ala GitHub).",
  "type": "module",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "dev": "node --experimental-sqlite scripts/dev-server.mjs",
    "test": "node --test --experimental-sqlite tests/*.test.mjs",
    "db:init": "wrangler d1 execute malude --file=schema.sql",
    "db:init:remote": "wrangler d1 execute malude --remote --file=schema.sql",
    "deploy": "wrangler pages deploy . --project-name malude-notepad-ideas"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0"
  }
}
